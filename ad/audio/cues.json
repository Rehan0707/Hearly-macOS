[
  {
    "id": 1,
    "start": 0.8,
    "end": 2.782,
    "text": "Every meeting starts with a voice.",
    "audio_file": "voice_01.wav"
  },
  {
    "id": 2,
    "start": 5.0,
    "end": 6.866,
    "text": "But life has a way of getting in.",
    "audio_file": "voice_02.wav"
  },
  {
    "id": 3,
    "start": 10.4,
    "end": 14.465,
    "text": "Meet Hearly. Your voice, brought into focus.",
    "audio_file": "voice_03.wav"
  },
  {
    "id": 4,
    "start": 17.0,
    "end": 20.443,
    "text": "Hearly learns the sound of your voice, right on your device.",
    "audio_file": "voice_04.wav"
  },
  {
    "id": 5,
    "start": 24.0,
    "end": 26.369,
    "text": "Then it separates you from the noise around you.",
    "audio_file": "voice_05.wav"
  },
  {
    "id": 6,
    "start": 30.3,
    "end": 35.769,
    "text": "The keyboard. The caf\u00e9. The conversation across the room.",
    "audio_file": "voice_06.wav"
  },
  {
    "id": 7,
    "start": 37.3,
    "end": 40.344,
    "text": "So when you speak, only your voice goes into the meeting.",
    "audio_file": "voice_07.wav"
  },
  {
    "id": 8,
    "start": 44.5,
    "end": 49.916,
    "text": "One clear connection. From your microphone, through Hearly, to your call.",
    "audio_file": "voice_08.wav"
  },
  {
    "id": 9,
    "start": 52.5,
    "end": 56.988,
    "text": "Hearly. Your voice. Nothing else.",
    "audio_file": "voice_09.wav"
  }
]
